# Program Perhitungan Kebutuhan Sumur Resapan 
# Rumus-rumus yang digunakan:
# Debit Puncak Limpasan (Q) = konstanta_rasional* C * I * A 
# Koefisien Limpasan Gabungan (C) = Σ(C[i] × A[i]) ÷ ΣA[i]
# Intensitas Hujan (I) = (r24 ÷ 24) × (24 ÷ t)^(2/3)
# Kedalaman Air Sumur Dibutuhkan (h_total) = [Q ÷ (F × K)] × [1 − exp(−F × K × T ÷ (π × R²))]
# Jumlah Sumur (n) = ceil(h_total/h_sumur)
import math

konstanta_rasional = 0.278
faktor_geometrik = 5.5
koef_limpasan = {
        "atap" : 0.90,
        "aspal" : 0.85,
        "beton" : 0.85,
        "paving": 0.70,
        "tanah" : 0.35,
        "taman" : 0.20,
        "kebun" : 0.20,
        "sawah" : 0.75,
}
def intesitas_mononobe(r24: float, durasi_jam: float):
    # Intensitas Hujan (I) = (r24 ÷ 24) × (24 ÷ t)^(2/3)
    return (r24/24.0)*(24.0/durasi_jam) **(2.0 /3.0)

def debit (c: float, intensitas:float, luas_m2:float):
    # Debit Puncak Limpasan (Q) = konstanta_rasional* C * I * A 
    return konstanta_rasional* c * intensitas *(luas_m2/1000000.0)

def kedalaman_air_total(q:float, k :float, jari:float, durasi_detik: float):
    # Kedalaman Air Sumur Dibutuhkan (h_total) = [Q ÷ (F × K)] × [1 − exp(−F × K × T ÷ (π × R²))]
    f = faktor_geometrik * jari
    eksponen = f * k * durasi_detik / (math.pi*jari**2)
    return q/(f*k)*(-math.expm1(-eksponen))
  
    #-math.expm1(-eksponen) = 1 - exp(-eksponen)
    # Fungsi ini dipakai karena menghitung exp(x) − 1 dengan akurat untuk x yang sangat kecil, sehingga 1 − exp(−eksponen) tidak kehilangan ketelitian akibat pengurangan dua bilangan yang hampir sama. 
    
def jumlah_sumur(h_total:float, h_sumur:float):
    # Jumlah Sumur (n) = ceil(h_total/h_sumur)
    return max(1, math.ceil(round(h_total/h_sumur,9)))

    # Fungsi max(1,jumlah_sumur) adalah untuk memastikan bahwa nilai akhir selalu minimal 1.
    # Jika h_total sangat kecil(mendekati 0), jumlah sumur akan menjadi nol. 
    # Fungsi round adalah untuk memastikan pembagian python yang sering tidak pas, seperti pembagian yang seharusnya 3.0 malah menjadi 3.000000000004.
    # Agar ceil(3.00000000004) tidak menjadi 4, bulatkan menjadi 3 menggunakan round.

def hitung(areas: list,durasi_jam:float,r24:float, k: float, jari: float, h_sumur: float):
    durasi_detik = durasi_jam * 3600

    i = intesitas_mononobe(r24, durasi_jam)

    q_area = []
    luas_total = 0

    for area in areas:                      # areas adalah sebuah list yang akan diinput, 
                                            # Di list tersebut ada dictionary yang memiliki 2 kunci yaitu "tipe" dan "luas"
        c = koef_limpasan[area["tipe"]]     # area["tipe"] akan memanggil value dari "tipe" dan hasil tersebut menjadi key untuk dictionary koef limpasan
        luas = area["luas"]

        q_area.append(debit(c,i,luas))     # append digunakan untuk menambahkan satu elemen baru ke posisi paling akhir sebuah list
        luas_total += luas

    q_total = sum(q_area)

    # Koefisien Limpasan Gabungan (C) = Σ(C[i] × A[i]) ÷ ΣA[i])
    c_gabungan = sum(koef_limpasan[area["tipe"]]*area["luas"] for area in areas) / luas_total
    

    h_total = kedalaman_air_total(q_total,k, jari, durasi_detik)
    n = jumlah_sumur(h_total, h_sumur)

    # Kembalikan data intensitas, c gabungan, luas total, debit total, kedalaman air total
    return i, c_gabungan, luas_total, q_total,h_total, n
    
def main():
    durasi_jam = float(input("Masukkan durasi hujan (jam): "))
    r24 = float(input("Masukkan curah hujan R24 (mm): "))

    k = float(input("Masukkan permeabilitas tanah (m/detik): "))

    jari = float(input("Masukkan jari-jari sumur (meter): "))
    h_sumur = float(input("Masukkan kedalaman sumur (meter): "))

    data_area = []

    while True: 
        tipe = input("Masukkan tipe lahan (atap, aspal, beton, paving, tanah, taman, kebun, atau sawah) (atau ketik 'selesai' untuk menghitung): ")
        if tipe == 'selesai':
            break

        if tipe not in koef_limpasan:
            print("Tipe lahan tidak dikenali")
            continue

        luas = float(input(f"Masukkan luas area untuk {tipe} (m2): "))

        data_area.append({"tipe": tipe, "luas":luas})

    #Dapatkan data intensitas, c gabungan, luas total, debit total, kedalaman air total menggunakan fungsi hitung()
    i, c_gabungan, luas_total, q_total, h_total, n = hitung(data_area, durasi_jam, r24, k, jari, h_sumur)
    
    print()
    print("="*50)
    print("      Hasil perhitungan sumur resapan")
    print("="*50)
    print(f"Luas Total Lahan            : {luas_total:.1f} m2")     # :.1f digunakan untuk membulatkan nilai menjadi 1 angka di belakang koma 
    print(f"Koefisien Limpasan Gabungan : {c_gabungan:.3f}")        # Selain luas dan tinggi angka koma lebih spesifik
    print(f"Intensitas Hujan            : {i:.3f} mm/jam")
    print(f"Debit Puncak                : {q_total:.3f} liter/detik")
    print(f"Kedalaman Air Total         : {h_total:.1f} m2")
    print("="*50)
    print(f"Jumlah sumur resapan dibutuhkan adalah {n} buah")

main()
